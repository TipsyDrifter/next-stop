{
  "name": "next-stop",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "description": "私鐵手帳 · Next Stop — 把人生當成一條私鐵來經營的個人生產力 App（Tauri 2 + React + SQLite，E2EE 同步）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
