*.sh text eol=lf
# migration SQL 由 include_str! 嵌進 exe，sqlx 用原始位元組算 checksum——CRLF checkout 會讓所有既有 DB 拒開（v1.1.5 真機踩到）
*.sql text eol=lf
# 並行地基金樣（契約 2026-09-29 §11.1）：逐位元組比對，autocrlf 改寫會全紅
src-tauri/src/sync/golden/** text eol=lf
scripts/probes/golden/** text eol=lf
# tt-notice 外掛的 permissions 由 tauri build 重寫（內容不變、行尾 LF）；鎖 LF 避免 autocrlf 讓 index 與工作樹 stat-dirty
src-tauri/plugins/tauri-plugin-tt-notice/permissions/** text eol=lf
# ns-restart 外掛同款：autogenerated permissions 由 tauri build 重寫（LF），鎖 LF 避免 stat-dirty
src-tauri/plugins/tauri-plugin-ns-restart/permissions/** text eol=lf
