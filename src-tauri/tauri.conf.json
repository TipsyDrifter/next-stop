{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "私鐵手帳",
  "version": "1.16.0",
  "identifier": "app.shitetsu.nextstop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "私鐵手帳 · Next Stop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "focus": false
      },
      {
        "label": "capture",
        "create": false,
        "url": "index.html?window=capture",
        "title": "記一句 · Next Stop",
        "width": 640,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false,
        "shadow": true,
        "minimizable": false,
        "maximizable": false,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
