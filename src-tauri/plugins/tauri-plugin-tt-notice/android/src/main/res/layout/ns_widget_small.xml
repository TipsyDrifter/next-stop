<?xml version="1.0" encoding="utf-8"?>
<!-- ⑬ 外部入口：主畫面小工具 4×1（原型 prototypes/外部入口.html 第 2 節）。id 跟 ns_widget_large 共用，NsWidget 同一份程式畫兩種。
     預設內容＝停車中，也是系統挑小工具時的預覽。根用 @android:id/background：API 31+ 系統靠它裁圓角、做開 App 的轉場。
     RemoteViews 只准用 FrameLayout／LinearLayout／ImageView／TextView／Chronometer 這些類別（不用 View）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ns_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/ns_w_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/ns_w_badge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ns_w_disc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ns_widget_disc" />

                <TextView
                    android:id="@+id/ns_w_glyph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/ns_widget_on_tile"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ns_widget_dot" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ns_w_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tt_idle_title"
                    android:textColor="@color/ns_widget_ink"
                    android:textSize="14.5sp" />

                <LinearLayout
                    android:id="@+id/ns_w_line2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/ns_w_started"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/ns_widget_faint"
                        android:textSize="12.5sp" />

                    <Chronometer
                        android:id="@+id/ns_w_chrono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/ns_widget_ink"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ns_w_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ns_widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ns_widget_depart"
            android:textColor="@color/ns_widget_on_ink"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/ns_w_today"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ns_widget_dash_v" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ns_widget_today"
                    android:textColor="@color/ns_widget_faint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/ns_w_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/ns_widget_no_count"
                    android:textColor="@color/ns_widget_ink"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
